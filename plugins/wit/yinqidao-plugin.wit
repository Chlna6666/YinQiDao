package yinqidao:music-plugin@0.1.0;

interface types {
    enum capability {
        authentication,
        search,
        metadata,
        lyrics,
        artwork,
        streaming,
        playlists,
        media-collections,
        cloud-library,
        recommendations,
        recognition,
        user-profile,
        like-sync,
        playback-events,
    }

    enum auth-method {
        qr-code,
        browser-oauth,
        device-code,
        cookie-import,
        custom-form,
    }

    record key-value {
        key: string,
        value: string,
    }

    record provider-descriptor {
        id: string,
        display-name: string,
        capabilities: list<capability>,
        auth-methods: list<auth-method>,
    }

    record plugin-manifest {
        id: string,
        name: string,
        version: string,
        abi-version: u32,
        description: string,
        homepage: option<string>,
        providers: list<provider-descriptor>,
        network-domains: list<string>,
    }

    enum auth-challenge-kind {
        qr-code,
        browser,
        device-code,
        form,
    }

    record auth-challenge {
        challenge-id: string,
        kind: auth-challenge-kind,
        verification-uri: option<string>,
        user-code: option<string>,
        qr-payload: option<string>,
        /// For form challenges each entry is `field-id -> Host display label`. Host-provided field
        /// values are sensitive, one-shot inputs returned only through `provider.auth-submit`.
        fields: list<key-value>,
        expires-at-ms: option<u64>,
    }

    record account {
        account-id: string,
        provider-id: string,
        display-name: string,
        avatar-url: option<string>,
        capabilities: list<capability>,
    }

    variant auth-poll {
        pending,
        authenticated(account),
        expired,
        denied(string),
    }

    record source-track-ref {
        provider-id: string,
        source-id: string,
    }

    record track-query {
        title: string,
        artists: list<string>,
        album: string,
        duration-ms: option<u64>,
        isrc: option<string>,
        musicbrainz-recording-id: option<string>,
        fingerprint-id: option<string>,
    }

    record remote-track {
        source: source-track-ref,
        title: string,
        artists: list<string>,
        album: string,
        duration-ms: option<u64>,
        isrc: option<string>,
        cover-url: option<string>,
        playable: bool,
        explicit: bool,
    }

    record lyric-word {
        timestamp-ms: u64,
        duration-ms: option<u64>,
        text: string,
    }

    record lyric-line {
        timestamp-ms: u64,
        text: string,
        translation: option<string>,
        words: list<lyric-word>,
    }

    record lyric-document {
        source: string,
        plain: option<string>,
        lines: list<lyric-line>,
    }

    record artwork-descriptor {
        url: string,
        headers: list<key-value>,
        expires-at-ms: option<u64>,
    }

    record stream-request {
        track: source-track-ref,
        quality: option<string>,
    }

    record stream-descriptor {
        url: string,
        headers: list<key-value>,
        codec: option<string>,
        bitrate: option<u32>,
        sample-rate: option<u32>,
        channels: option<u16>,
        expires-at-ms: option<u64>,
    }

    enum recommendation-surface {
        home,
        daily-mix,
        discovery,
        similar-track,
        artist-radio,
        continue-listening,
    }

    record recommendation-request {
        surface: recommendation-surface,
        seed: option<track-query>,
        limit: u16,
        exclude: list<source-track-ref>,
    }

    record recommendation-item {
        track: remote-track,
        score: option<f32>,
        reason: option<string>,
    }

    record recognition-request {
        algorithm: string,
        fingerprint: list<u8>,
        duration-ms: u64,
    }

    record recognition-result {
        track: remote-track,
        confidence: option<f32>,
    }

    record playlist {
        provider-id: string,
        source-id: string,
        name: string,
        cover-url: option<string>,
        track-count: option<u32>,
        editable: bool,
    }

    enum media-collection-kind {
        playlist,
        album,
        artist,
        video,
    }

    record media-collection-ref {
        provider-id: string,
        kind: media-collection-kind,
        source-id: string,
    }

    /// Generic saved/recommended remote collection. Provider-specific protocol details never cross
    /// this boundary; playlists, albums, artists and videos share one typed Host-facing model.
    record media-collection {
        source: media-collection-ref,
        title: string,
        subtitle: option<string>,
        artwork-url: option<string>,
        item-count: option<u32>,
        editable: bool,
        saved: option<bool>,
    }

    enum collection-recommendation-surface {
        home,
        daily,
        discovery,
        similar,
    }

    record collection-recommendation-request {
        surface: collection-recommendation-surface,
        kind: media-collection-kind,
        seed: option<media-collection-ref>,
        limit: u16,
        exclude: list<media-collection-ref>,
    }

    record collection-recommendation-item {
        collection: media-collection,
        score: option<f32>,
        reason: option<string>,
    }

    record user-profile {
        provider-id: string,
        account-id: string,
        display-name: string,
        avatar-url: option<string>,
        bio: option<string>,
        level: option<u32>,
        follower-count: option<u32>,
        following-count: option<u32>,
        playlist-count: option<u32>,
        listen-count: option<u64>,
    }

    enum playback-signal-kind {
        started,
        completed,
        skipped,
        liked,
        unliked,
        disliked,
    }

    record playback-signal {
        kind: playback-signal-kind,
        track: track-query,
        source: option<source-track-ref>,
        position-ms: u64,
        duration-ms: u64,
        occurred-at-ms: u64,
    }
}

interface host {
    use types.{key-value};

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    record http-request-data {
        provider-id: string,
        account-id: option<string>,
        method: string,
        url: string,
        headers: list<key-value>,
        body: list<u8>,
    }

    record http-response {
        status: u16,
        headers: list<key-value>,
        body: list<u8>,
    }

    record secret-scope {
        provider-id: string,
        account-id: option<string>,
    }

    /// Host-mediated network access. `provider-id` is explicit so one component can safely expose
    /// multiple music services while the Host applies per-provider policy, tracing and budgets.
    http-request: func(request: http-request-data) -> result<http-response, string>;

    /// The Host injects plugin identity from the instantiated component. Guests choose only a
    /// provider scope or a provider+account scope; they can never address another plugin namespace.
    secret-get: func(scope: secret-scope, key: string) -> result<option<list<u8>>, string>;
    secret-set: func(scope: secret-scope, key: string, value: list<u8>) -> result<bool, string>;
    secret-delete: func(scope: secret-scope, key: string) -> result<bool, string>;

    now-ms: func() -> u64;
    log: func(level: log-level, message: string);
}

interface provider {
    use types.{
        account,
        artwork-descriptor,
        auth-challenge,
        auth-method,
        auth-poll,
        collection-recommendation-item,
        collection-recommendation-request,
        key-value,
        lyric-document,
        media-collection,
        media-collection-kind,
        media-collection-ref,
        playback-signal,
        playlist,
        plugin-manifest,
        recognition-request,
        recognition-result,
        recommendation-item,
        recommendation-request,
        remote-track,
        source-track-ref,
        stream-descriptor,
        stream-request,
        track-query,
        user-profile,
    };

    manifest: func() -> plugin-manifest;

    accounts: func(provider-id: string) -> result<list<account>, string>;
    auth-begin: func(provider-id: string, method: auth-method) -> result<auth-challenge, string>;
    poll-auth: func(provider-id: string, challenge-id: string) -> result<auth-poll, string>;
    /// Submit one Host-rendered form. Values are one-shot sensitive inputs; persistent credentials
    /// must be stored by the guest through the Host `secret-set` import.
    auth-submit: func(provider-id: string, challenge-id: string, values: list<key-value>) -> result<auth-poll, string>;
    auth-cancel: func(provider-id: string, challenge-id: string) -> result<bool, string>;
    logout: func(provider-id: string, account-id: string) -> result<bool, string>;

    search: func(provider-id: string, account-id: option<string>, query: string, limit: u16) -> result<list<remote-track>, string>;
    resolve-track: func(provider-id: string, account-id: option<string>, query: track-query) -> result<option<remote-track>, string>;
    lyrics: func(provider-id: string, account-id: option<string>, track: source-track-ref) -> result<option<lyric-document>, string>;
    artwork: func(provider-id: string, account-id: option<string>, track: source-track-ref) -> result<option<artwork-descriptor>, string>;
    %stream: func(provider-id: string, account-id: string, request: stream-request) -> result<stream-descriptor, string>;

    playlists: func(provider-id: string, account-id: string) -> result<list<playlist>, string>;
    playlist-tracks: func(provider-id: string, account-id: string, playlist-id: string, offset: u32, limit: u16) -> result<list<remote-track>, string>;
    playlist-create: func(provider-id: string, account-id: string, name: string) -> result<playlist, string>;
    playlist-add: func(provider-id: string, account-id: string, playlist-id: string, tracks: list<source-track-ref>) -> result<bool, string>;
    playlist-remove: func(provider-id: string, account-id: string, playlist-id: string, tracks: list<source-track-ref>) -> result<bool, string>;

    /// Generic remote-library collection access. This deliberately avoids provider-specific names.
    media-collections: func(provider-id: string, account-id: string, kind: media-collection-kind, offset: u32, limit: u16) -> result<list<media-collection>, string>;
    set-media-saved: func(provider-id: string, account-id: string, collection: media-collection-ref, saved: bool) -> result<bool, string>;
    collection-recommendations: func(provider-id: string, account-id: string, request: collection-recommendation-request) -> result<list<collection-recommendation-item>, string>;
    user-profile: func(provider-id: string, account-id: string) -> result<user-profile, string>;

    cloud-library: func(provider-id: string, account-id: string, offset: u32, limit: u16) -> result<list<remote-track>, string>;
    liked-tracks: func(provider-id: string, account-id: string, offset: u32, limit: u16) -> result<list<remote-track>, string>;
    set-liked: func(provider-id: string, account-id: string, track: source-track-ref, liked: bool) -> result<bool, string>;

    recommendations: func(provider-id: string, account-id: string, request: recommendation-request) -> result<list<recommendation-item>, string>;
    recognize: func(provider-id: string, account-id: option<string>, request: recognition-request) -> result<option<recognition-result>, string>;
    report-playback: func(provider-id: string, account-id: string, signal: playback-signal) -> result<bool, string>;
}

/// Declarative plugin UI transport. The wire format is a flat node arena rather than a recursive
/// WIT type. Child references are indices into `ui-page.nodes`; the Host validates bounds, cycles,
/// shared subtrees, reachability, schema limits and text/ID constraints before GPUI sees a page.
interface ui {
    enum spacer-size {
        small,
        medium,
        large,
    }

    record select-option {
        value: string,
        label: string,
    }

    record heading-node {
        level: u8,
        text: string,
    }

    record section-node {
        title: option<string>,
        children: list<u32>,
    }

    record image-node {
        asset: string,
        alt: option<string>,
    }

    record button-node {
        label: string,
        action-id: string,
        disabled: bool,
    }

    record input-node {
        field-id: string,
        value: string,
        placeholder: option<string>,
        secret: bool,
    }

    record select-node {
        field-id: string,
        selected: option<string>,
        options: list<select-option>,
    }

    record toggle-node {
        field-id: string,
        label: string,
        value: bool,
    }

    record progress-node {
        value-basis-points: u16,
        label: option<string>,
    }

    variant node-kind {
        text(string),
        heading(heading-node),
        column(list<u32>),
        row(list<u32>),
        section(section-node),
        card(list<u32>),
        %list(list<u32>),
        image(image-node),
        button(button-node),
        input(input-node),
        select(select-node),
        toggle(toggle-node),
        progress(progress-node),
        badge(string),
        divider,
        spacer(spacer-size),
    }

    record ui-node {
        kind: node-kind,
    }

    record ui-page {
        root: u32,
        nodes: list<ui-node>,
    }

    variant field-value {
        text(string),
        boolean(bool),
    }

    record field-entry {
        field-id: string,
        value: field-value,
    }

    record action-event {
        action-id: string,
        fields: list<field-entry>,
    }

    record field-change-event {
        field-id: string,
        value: field-value,
    }

    variant ui-event {
        action(action-event),
        field-changed(field-change-event),
    }

    record ui-response {
        page: option<ui-page>,
        toast: option<string>,
        close: bool,
    }

    enum command-surface {
        command-palette,
        track-context,
        playlist-context,
        page-local,
    }

    record command-track-context {
        title: string,
        artists: list<string>,
        album: string,
        duration-ms: option<u64>,
        provider-id: option<string>,
        source-id: option<string>,
    }

    record command-playlist-context {
        name: option<string>,
        provider-id: option<string>,
        source-id: option<string>,
    }

    record command-context {
        surface: command-surface,
        page-id: option<string>,
        track: option<command-track-context>,
        playlist: option<command-playlist-context>,
    }

    record command-response {
        toast: option<string>,
        open-page-id: option<string>,
    }

    load-page: func(page-id: string) -> result<ui-page, string>;
    handle-event: func(page-id: string, event: ui-event) -> result<ui-response, string>;
    invoke-command: func(command-id: string, context: command-context) -> result<command-response, string>;
}

world music-plugin {
    import host;
    export provider;
    export ui;
}
